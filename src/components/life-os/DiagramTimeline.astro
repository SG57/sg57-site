---
/** "Why now": five steps as real HTML, vertical on phones, horizontal from 640px. Motion only when revealed. */
---

<ol class="tl" data-reveal aria-label="How AI assistants changed">
  <li class="tl-node">
    <span class="tl-dot" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="3"/><rect x="15" y="8" width="6" height="8" rx="2"/><path d="M10 12h4M12 10l2 2-2 2"/></svg>
    </span>
    <span class="tl-label">Answers</span>
    <span class="tl-sub">when you ask, then forgets</span>
  </li>
  <li class="tl-node">
    <span class="tl-dot" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12v18H6zM9 8h6M9 12h6M9 16h4"/></svg>
    </span>
    <span class="tl-label">Remembers</span>
    <span class="tl-sub">you, between chats</span>
  </li>
  <li class="tl-node">
    <span class="tl-dot" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v14H4zM4 10h16M8 3v5M16 3v5"/></svg>
    </span>
    <span class="tl-label">Connects</span>
    <span class="tl-sub">to calendar and mail, if you allow</span>
  </li>
  <li class="tl-node tl-now">
    <span class="tl-dot" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="3"/><rect x="15" y="8" width="6" height="8" rx="2"/><g class="tl-arrow"><path d="M14 12h-4M12 10l-2 2 2 2"/></g><path class="tl-ring" d="M2 8a6 6 0 0 0 0 8"/></svg>
    </span>
    <span class="tl-label">Reaches out</span>
    <span class="tl-sub">messages you first</span>
  </li>
  <li class="tl-node tl-next">
    <span class="tl-dot" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="12" r="5"/><circle cx="15" cy="12" r="5"/></svg>
    </span>
    <span class="tl-label">Next</span>
    <span class="tl-sub">yours works with your partner's (in development)</span>
  </li>
</ol>

<style>
  .tl { user-select: none; -webkit-user-select: none; list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 1.1rem; }
  .tl::before { content: ""; position: absolute; left: 21px; top: 22px; bottom: 22px; width: 2px; background: var(--sg57-border); }
  .tl-node { position: relative; display: grid; grid-template-columns: 44px 1fr; column-gap: 1rem; align-items: start; }
  .tl-dot {
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: var(--sg57-surface); border: 2px solid var(--sg57-text-dim); color: var(--sg57-text);
  }
  .tl-dot svg { width: 24px; height: 24px; }
  .tl-label { grid-column: 2; font-family: var(--sg57-font-display); font-weight: 600; font-size: 1.15rem; color: var(--sg57-text-bright); line-height: 1.2; }
  .tl-sub { grid-column: 2; color: var(--sg57-text-dim); font-size: 0.95rem; line-height: 1.4; }
  .tl-now .tl-dot { border: 3px solid var(--sg57-accent); background: var(--sg57-accent-glow); color: var(--sg57-accent); position: relative; }
  .tl-now .tl-label { color: var(--sg57-accent); }
  .tl-ring { stroke: var(--sg57-accent); }
  .tl-next .tl-dot { border-style: dashed; }
  .tl-next .tl-label, .tl-next .tl-sub { color: var(--sg57-text-dim); }
  .tl-arrow { transform-box: fill-box; transform-origin: center; }

  @media (min-width: 640px) {
    .tl { grid-template-columns: repeat(5, 1fr); gap: 0.75rem; }
    .tl::before { left: 10%; right: 10%; top: 22px; bottom: auto; width: auto; height: 2px; }
    .tl-node { grid-template-columns: 1fr; justify-items: center; text-align: center; row-gap: 0.4rem; }
    .tl-label, .tl-sub { grid-column: 1; }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.lo[data-anim]) .tl-node { opacity: 0; }
    :global(.lo[data-anim]) .tl.in .tl-node { animation: lo-rise 0.8s var(--sg57-ease-snap, cubic-bezier(0.4, 0, 0.2, 1)) both; }
    :global(.lo[data-anim]) .tl.in .tl-node:nth-child(2) { animation-delay: 0.12s; }
    :global(.lo[data-anim]) .tl.in .tl-node:nth-child(3) { animation-delay: 0.24s; }
    :global(.lo[data-anim]) .tl.in .tl-node:nth-child(4) { animation-delay: 0.36s; }
    :global(.lo[data-anim]) .tl.in .tl-node:nth-child(5) { animation-delay: 0.48s; }
    :global(.lo[data-anim]) .tl.in .tl-arrow { animation: lo-flip 0.5s var(--sg57-ease-snap, cubic-bezier(0.4, 0, 0.2, 1)) 1.2s both; }
    :global(.lo[data-anim]) .tl.in .tl-now .tl-dot::after {
      content: ""; position: absolute; inset: -3px; border-radius: 50%; border: 2px solid var(--sg57-accent);
      animation: lo-ping 1.2s ease-out 1.7s 2 both;
    }
  }
</style>
