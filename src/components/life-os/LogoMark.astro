---
/**
 * The Life OS mark: an "on" ring around a tiny org chart (you above, departments below), in the Life OS sage.
 * `size` is the mark's pixel size; `wordmark` adds LIFE OS beside it. Decorative: aria-hidden unless a label is given.
 */
interface Props { size?: number; wordmark?: boolean; label?: string; class?: string }
const { size = 64, wordmark = false, label, class: cls } = Astro.props;
---

<span class:list={['lo-logo', cls]} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <svg class="lo-mark" width={size} height={size} viewBox="0 0 64 64" fill="none">
    <circle cx="32" cy="32" r="29" stroke="currentColor" stroke-width="3" opacity="0.9"/>
    <path d="M32 3a29 29 0 0 1 0 0" stroke="currentColor" stroke-width="3"/>
    <circle cx="32" cy="7" r="3.5" fill="currentColor" class="lo-mark-on"/>
    <circle cx="32" cy="22" r="5" fill="currentColor"/>
    <path d="M32 27v6M20 40v-4h24v4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="20" cy="44" r="4" stroke="currentColor" stroke-width="2.5"/>
    <circle cx="32" cy="44" r="4" stroke="currentColor" stroke-width="2.5"/>
    <circle cx="44" cy="44" r="4" stroke="currentColor" stroke-width="2.5"/>
  </svg>
  {wordmark && <span class="lo-word">LIFE<span class="lo-word-os">OS</span></span>}
</span>

<style>
  .lo-logo { display: inline-flex; align-items: center; gap: 0.6em; color: var(--sg57-accent); user-select: none; -webkit-user-select: none; }
  .lo-mark { filter: drop-shadow(0 0 14px var(--sg57-accent-glow)) drop-shadow(0 0 4px rgba(143, 191, 159, 0.5)); flex: none; }
  .lo-word { font-family: var(--sg57-font-display); font-weight: 700; letter-spacing: 0.22em; font-size: 1.6em; color: var(--sg57-text-bright); line-height: 1; }
  .lo-word-os { color: var(--sg57-accent); margin-left: 0.25em; }
  @media (prefers-reduced-motion: no-preference) {
    .lo-mark-on { transform-box: fill-box; transform-origin: center; animation: lo-logo-pulse 2.4s ease-in-out infinite; }
  }
  @keyframes lo-logo-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.55; transform: scale(1.35); } }
</style>
