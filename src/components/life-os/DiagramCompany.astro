---
/**
 * "Your life as a company" as real HTML: you (CEO), your assistant (chief of staff), a weekly Brief
 * rising between them, and the departments below. Full mode: each department is a disclosure with one
 * example task. Compact mode (the short page): departments are plain chips, the partner box is detail-only.
 */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const depts = [
  { key: 'good', name: 'Good Life', tag: 'always on', task: 'One thing to look forward to, every week.', icon: 'M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z' },
  { key: 'money', name: 'Money', task: 'Car payment Thursday. It reminds you; you pay.', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 8v8M10 10h3a2 2 0 0 1 0 4h-3' },
  { key: 'protection', name: 'Protection', task: "Benefits enrollment closes in 9 days. Here's what to compare.", icon: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z' },
  { key: 'health', name: 'Health', task: "Checkup is due. Here's what to say when you call.", icon: 'M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z' },
  { key: 'home', name: 'Home', task: 'Furnace filter, every 90 days.', icon: 'M4 11l8-7 8 7v9H4z' },
  { key: 'paperwork', name: 'Paperwork', task: 'Passport expires in 7 months. Renewal steps are ready.', icon: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h6M9 17h6' },
  { key: 'pets', name: 'Pets', task: 'Rabies shot due next month.', icon: 'M8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM16 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM4 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM20 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM12 11c-3 0-6 3-6 6a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3c0-3-3-6-6-6z' },
];
---

<div class="org" data-reveal>
  <div class="org-box org-ceo"><span class="org-name">You</span><span class="org-role">CEO</span></div>
  <div class="org-conn org-conn-up">
    <div class="org-env" aria-hidden="true">
      <svg viewBox="0 0 22 16" width="22" height="16"><rect width="22" height="16" rx="2" fill="currentColor"/><path d="M1 2l10 7 10-7" fill="none" stroke="var(--sg57-text-on-accent)" stroke-width="1.6"/></svg>
      <span class="org-env-tag">weekly Brief</span>
    </div>
  </div>
  <div class="org-box org-cos"><span class="org-name">Your assistant</span><span class="org-role">chief of staff</span></div>
  <div class="org-conn"></div>
  <p class="org-note">Start with any 2. Add more later.</p>
  <ul class="org-depts">
    {depts.map((d) => (
      <li class:list={['dept-item', { 'dept-good': d.key === 'good' }]}>
        {compact ? (
          <span class="dept dept-static">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d.icon}/></svg>
            <span class="dept-name">{d.name}</span>
            {d.tag && <span class="dept-tag">{d.tag}</span>}
          </span>
        ) : (
          <details class="dept">
            <summary>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d.icon}/></svg>
              <span class="dept-name">{d.name}</span>
              {d.tag && <span class="dept-tag">{d.tag}</span>}
              <span class="dept-chev" aria-hidden="true"></span>
            </summary>
            <p class="dept-task">{d.task}</p>
          </details>
        )}
      </li>
    ))}
  </ul>
  <p class="org-link"><span class="pill">Pets</span><span class="org-arrows" aria-hidden="true">⇄</span><span class="pill">Money</span><span class="org-link-text">a vet bill lands in both</span></p>
  <div class="org-ghost" data-show={compact ? 'normal technical' : undefined}><span class="org-name">A partner's Life OS</span><span class="org-role">in development</span></div>
</div>

<style>
  .org { user-select: none; -webkit-user-select: none; display: flex; flex-direction: column; align-items: center; width: 100%; }
  .org-box { display: flex; flex-direction: column; align-items: center; gap: 0.1rem; min-width: 180px; padding: 0.7rem 1.1rem; border-radius: var(--sg57-radius-lg); background: var(--sg57-surface); border: 2px solid var(--sg57-text-dim); }
  .org-ceo { border: 2.5px solid var(--sg57-accent); }
  .org-name { font-family: var(--sg57-font-display); font-weight: 700; font-size: 1.15rem; color: var(--sg57-text-bright); }
  .org-role { font-family: var(--sg57-font-display); font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sg57-text-dim); }
  .org-conn { position: relative; width: 2px; height: 24px; background: var(--sg57-border); }
  .org-conn-up { height: 48px; background: var(--sg57-accent); }
  .org-env { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; gap: 0.4rem; color: var(--sg57-accent); white-space: nowrap; }
  .org-env-tag { font-family: var(--sg57-font-display); font-size: 0.8rem; color: var(--sg57-text-dim); letter-spacing: 0.04em; }
  .org-note { margin: 0.6rem 0 0.8rem; font-family: var(--sg57-font-display); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sg57-accent); text-align: center; }
  .org-depts { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
  .dept-good { grid-column: span 2; }
  .dept { display: block; border-radius: var(--sg57-radius-md); background: var(--sg57-glass-bg); border: 1px solid var(--sg57-glass-border); }
  .dept-good .dept { border-color: var(--sg57-accent); background: var(--sg57-accent-glow); }
  .dept summary, .dept-static { list-style: none; display: flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0.5rem 0.75rem; color: var(--sg57-text); }
  .dept summary { cursor: pointer; }
  .dept summary::-webkit-details-marker { display: none; }
  .dept summary:focus-visible { outline: 2px solid transparent; box-shadow: var(--sg57-focus-ring); border-radius: var(--sg57-radius-md); }
  .dept-name { font-family: var(--sg57-font-display); font-weight: 600; font-size: 1rem; color: var(--sg57-text-bright); }
  .dept-tag { font-family: var(--sg57-font-display); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sg57-accent); }
  .dept-chev { margin-left: auto; width: 8px; height: 8px; border-right: 2px solid var(--sg57-text-dim); border-bottom: 2px solid var(--sg57-text-dim); transform: rotate(45deg); }
  .dept[open] .dept-chev { transform: rotate(-135deg); }
  .dept-task { margin: 0; padding: 0 0.75rem 0.7rem; color: var(--sg57-text); line-height: 1.45; font-size: 0.95rem; }
  .org-link { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.4rem; margin: 1rem 0 0.5rem; color: var(--sg57-text-dim); }
  .pill { font-family: var(--sg57-font-display); font-weight: 600; font-size: 0.85rem; padding: 0.2rem 0.6rem; border-radius: var(--sg57-radius-full); border: 1px solid var(--sg57-accent-muted); color: var(--sg57-text); }
  .org-arrows { color: var(--sg57-accent); }
  .org-link-text { font-size: 0.9rem; }
  .org-ghost { display: flex; flex-direction: column; align-items: center; margin-top: 0.4rem; padding: 0.5rem 1rem; border-radius: var(--sg57-radius-lg); border: 2px dashed var(--sg57-accent-muted); }
  .org-ghost .org-name { color: var(--sg57-text-dim); font-size: 1rem; }

  @media (min-width: 640px) { .org-depts { grid-template-columns: repeat(4, 1fr); } .dept-good { grid-column: span 1; } }
  .dept-name { white-space: nowrap; }
  @media (min-width: 900px) {
    .org-depts { grid-template-columns: repeat(7, 1fr); }
    /* Seven across leaves no room for the tag; the accent border already marks Good Life as special. */
    .dept-static .dept-tag { display: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dept-chev { transition: transform 0.2s var(--sg57-ease-out); }
    :global(.lo[data-anim]) .dept-item, :global(.lo[data-anim]) .org-env { opacity: 0; }
    :global(.lo[data-anim]) .org.in .dept-item { animation: lo-rise 0.8s var(--sg57-ease-snap, cubic-bezier(0.4, 0, 0.2, 1)) both; }
    :global(.lo[data-anim]) .org.in .dept-item:nth-child(2) { animation-delay: 0.08s; }
    :global(.lo[data-anim]) .org.in .dept-item:nth-child(3) { animation-delay: 0.16s; }
    :global(.lo[data-anim]) .org.in .dept-item:nth-child(4) { animation-delay: 0.24s; }
    :global(.lo[data-anim]) .org.in .dept-item:nth-child(5) { animation-delay: 0.32s; }
    :global(.lo[data-anim]) .org.in .dept-item:nth-child(6) { animation-delay: 0.40s; }
    :global(.lo[data-anim]) .org.in .dept-item:nth-child(7) { animation-delay: 0.48s; }
    :global(.lo[data-anim]) .org.in .org-env { animation: lo-rise 0.8s var(--sg57-ease-snap, cubic-bezier(0.4, 0, 0.2, 1)) 0.9s both; }
  }
</style>
