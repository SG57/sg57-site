---
/** The three things it never does, as tiles with a struck-through icon, plus the three control words. */
interface Props { technical?: boolean }
---

<ul class="never" data-reveal aria-label="What it never does">
  <li>
    <span class="nv-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M10 10h3a2 2 0 0 1 0 4h-3"/></svg>
      <span class="nv-strike-wrap"><span class="nv-strike"></span></span>
    </span>
    <span class="nv-text">Never pays or moves money.</span>
    <code class="nv-id" data-show="technical">S2.4</code>
  </li>
  <li>
    <span class="nv-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-8-8 18-2-8z"/></svg>
      <span class="nv-strike-wrap"><span class="nv-strike"></span></span>
    </span>
    <span class="nv-text">Never sends, books, shares, or deletes without reading it back and hearing your yes.</span>
    <code class="nv-id" data-show="technical">S2.1 T3 · S2.2</code>
  </li>
  <li>
    <span class="nv-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4l6 6M12 6l6 6M13 9l-8 8M4 20h8"/></svg>
      <span class="nv-strike-wrap"><span class="nv-strike"></span></span>
    </span>
    <span class="nv-text">Never decides legal, medical, tax, or money questions. It names who does.</span>
    <code class="nv-id" data-show="technical">S3.2</code>
  </li>
</ul>

<style>
  .never { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; }
  .never li { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.1rem 1.2rem; border-radius: var(--sg57-radius-lg); background: var(--sg57-glass-bg); border: 1px solid var(--sg57-glass-border); }
  .nv-icon { position: relative; width: 44px; height: 44px; color: var(--sg57-text); }
  .nv-icon svg { width: 32px; height: 32px; margin: 6px; }
  .nv-strike-wrap { position: absolute; left: 0; top: 21px; width: 44px; height: 2px; transform: rotate(-35deg); transform-origin: center; }
  .nv-strike { display: block; width: 100%; height: 100%; background: var(--sg57-accent); transform-origin: left; }
  .nv-text { color: var(--sg57-text); line-height: 1.45; }
  .nv-id { font-family: var(--sg57-font-mono); font-size: 0.8rem; color: var(--sg57-accent); }
  @media (max-width: 720px) { .never { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: no-preference) {
    :global(.lo[data-anim]) .nv-strike { transform: scaleX(0); }
    :global(.lo[data-anim]) .never.in .nv-strike { animation: lo-draw 0.5s var(--sg57-ease-snap, cubic-bezier(0.4, 0, 0.2, 1)) both; }
    :global(.lo[data-anim]) .never.in li:nth-child(2) .nv-strike { animation-delay: 0.15s; }
    :global(.lo[data-anim]) .never.in li:nth-child(3) .nv-strike { animation-delay: 0.3s; }
  }
</style>
