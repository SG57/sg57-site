---
/** Three steps as a filmstrip: open your AI app, copy the message below, paste it and answer. */
---

<ol class="film" data-reveal aria-label="The three steps">
  <li>
    <span class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"/><circle cx="12" cy="18" r="1"/></svg></span>
    <span class="f-num">1</span>
    <span class="f-text">Open your AI app</span>
  </li>
  <li>
    <span class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="17" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/></svg></span>
    <span class="f-num">2</span>
    <span class="f-text">Copy the message below</span>
  </li>
  <li>
    <span class="f-icon f-icon-accent" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4zM9 10l2 2 4-4"/></svg></span>
    <span class="f-num">3</span>
    <span class="f-text">Paste it. Answer questions.</span>
  </li>
</ol>

<style>
  .film { list-style: none; margin: 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .film::before { content: ""; position: absolute; top: 28px; left: 16%; right: 16%; height: 2px; background: var(--sg57-border); transform-origin: left; }
  .film li { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.35rem; }
  .f-icon { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--sg57-surface); border: 2px solid var(--sg57-text-dim); color: var(--sg57-text); }
  .f-icon svg { width: 28px; height: 28px; }
  .f-icon-accent { border-color: var(--sg57-accent); color: var(--sg57-accent); }
  .f-num { font-family: var(--sg57-font-display); font-weight: 700; font-size: 0.8rem; color: var(--sg57-accent); letter-spacing: 0.1em; }
  .f-text { font-family: var(--sg57-font-display); font-weight: 600; font-size: 1rem; color: var(--sg57-text-bright); line-height: 1.25; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.lo[data-anim]) .film::before { transform: scaleX(0); }
    :global(.lo[data-anim]) .film.in::before { animation: lo-draw 0.6s var(--sg57-ease-snap, cubic-bezier(0.4, 0, 0.2, 1)) both; }
    :global(.lo[data-anim]) .film li { opacity: 0; }
    :global(.lo[data-anim]) .film.in li { animation: lo-rise 0.8s var(--sg57-ease-snap, cubic-bezier(0.4, 0, 0.2, 1)) both; }
    :global(.lo[data-anim]) .film.in li:nth-child(2) { animation-delay: 0.12s; }
    :global(.lo[data-anim]) .film.in li:nth-child(3) { animation-delay: 0.24s; }
  }
</style>
