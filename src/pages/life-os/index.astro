---
import Base from '../../layouts/Base.astro';
import ModeSwitch from '../../components/life-os/ModeSwitch.astro';
import BriefPhone from '../../components/life-os/BriefPhone.astro';
import Filmstrip from '../../components/life-os/Filmstrip.astro';
import DiagramTimeline from '../../components/life-os/DiagramTimeline.astro';
import DiagramCompany from '../../components/life-os/DiagramCompany.astro';
import NeverTiles from '../../components/life-os/NeverTiles.astro';
import SetupStory from '../../components/life-os/SetupStory.astro';
import RecommendCards from '../../components/life-os/RecommendCards.astro';
import {
  version, fingerprint, checksums, pasteKB, isRC, noResultsYet, trustRuleIds, safetySections, allUntested,
  assertCited, assertRecommended,
} from '../../lib/lifeos-kit';

// Every rule id this page cites, with a phrase its definition must still contain. The build fails on drift.
assertCited({
  'S1.2': /Precedence/i, 'S1.4': /do not follow it/i, 'S1.5': /never supplies a way to act/i,
  'S2.1': /T3 irreversible/i, 'S2.2': /read-back/i, 'S2.3': /never runs from a schedule/i,
  'S2.4': /pay or move money/i, 'S2.5': /autonomy_max/i, 'S2.7': /"stop"/i, 'S3.2': /professional/i,
  'S5.1': /Updates are proposals/i, 'B2': /what you can do here/i, 'B10': /at most 2 areas/i,
  'R1': /One Brief a week/i, 'R8': /outside the Brief/i, 'V1': /fixed template/i, 'X1': /offboard/i,
});
assertRecommended(['Meta Muse', 'Grok Bot']);

const HEADLINE = 'An assistant that messages you first.';
const areas = [
  { id: 'money', label: 'Money' },
  { id: 'protection', label: 'Protection (insurance and benefits)' },
  { id: 'health', label: 'Health' },
  { id: 'home', label: 'Home' },
  { id: 'paperwork', label: 'Paperwork (taxes, IDs, legal)' },
  { id: 'pets', label: 'Pets' },
];
---

<Base
  title={`Life OS: ${HEADLINE.replace(/\.$/, '')} | SG57 Labs`}
  description="Paste one message into the AI assistant you already use. Twenty minutes later it runs your life's back office, with one short Brief a week. Free. Test version."
  accentColor="#8FBF9F"
  accentHover="#A3D1B1"
  accentMuted="#6F9D80"
  accentGlow="rgba(143, 191, 159, 0.15)"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Set up Life OS in your AI assistant',
    description: 'Copy one setup message, paste it into the AI assistant you already use, answer its questions for about twenty minutes.',
    totalTime: 'PT20M',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Open your AI app', text: 'Open the AI assistant you already use, on your own device.' },
      { '@type': 'HowToStep', position: 2, name: 'Copy the setup message', text: 'Copy the whole setup message from sg57.dev/life-os.' },
      { '@type': 'HowToStep', position: 3, name: 'Paste it and answer', text: 'Paste it, send it, and answer the questions. No bank or email connection is needed.' },
    ],
  }}
>
<div class="lo" data-lifeos data-mode="beginner">
<script is:inline data-astro-rerun>
(function(){var r=document.querySelector('[data-lifeos]');if(!r)return;r.setAttribute('data-js','');
var M=['beginner','normal','technical'],m=null;
try{var q=new URLSearchParams(location.search).get('mode');if(M.indexOf(q)>-1)m=q;}catch(e){}
if(!m){try{var s=localStorage.getItem('lifeos-mode');if(M.indexOf(s)>-1)m=s;}catch(e){}}
r.setAttribute('data-mode',m||'beginner');})();
</script>
<a class="sr-only lo-skip" href="#copy">Skip to the setup message</a>

  <!-- S1 Hero -->
  <section class="hero" id="top">
    <div class="container bloom hero-grid">
      <div class="hero-text">
        <span class="eyebrow" data-show="beginner normal">LIFE OS · FREE · {isRC ? 'TEST VERSION' : 'VERSION ' + version}</span>
        <span class="eyebrow" data-show="technical">LIFE OS {version}{isRC ? ' · RELEASE CANDIDATE' : ''}</span>
        <h1 class="headline">{HEADLINE}<br /><span class="headline-accent">You never keep a list.</span></h1>
        <div class="sub-stack">
          <p class="lede" data-show="beginner">AI apps can now remember you and reach out on their own. Life OS gives yours a job: keeping track of bills, renewals, and appointments.</p>
          <p class="lede" data-show="normal technical">Paste one message into the AI assistant you already use. Twenty minutes of questions, one thing handled on the spot, then one Brief a week.</p>
        </div>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#copy">Try it · 20 min <span aria-hidden="true">↓</span></a>
          <a class="btn btn-ghost" href="#why">Why now?</a>
        </div>
        <div class="mode-row">
          <ModeSwitch />
          <a class="lo-safe" href="/life-os/trust">Is it safe? <span aria-hidden="true">→</span></a>
        </div>
        <p class="spec" data-show="technical">Vendor-neutral prompt kit · kit {fingerprint} · {pasteKB} KB setup paste · 5 kernel files · 3 capability tiers</p>
      </div>
      <div class="hero-phone">
        <BriefPhone>
          <span data-show="beginner normal">Example. If your app can't message first, a phone reminder does.</span>
          <span data-show="technical">Example. Format per RHYTHM R1: 250 words or fewer; Done, Needs you (at most 3, each with a default), Something good; "On my side" appears only when something broke. Tier 2 sends it on a schedule; tiers 0 and 1 rely on a phone-calendar reminder.</span>
        </BriefPhone>
      </div>
    </div>
  </section>

  <!-- S2 Start -->
  <section class="section container" id="start">
    <h2 class="h2">Try it. 20 minutes. Just copy and paste.</h2>
    <Filmstrip />
    <p class="best">Best with <strong>Meta Muse</strong> (free to start) or <strong>Grok Bot</strong> (paid). Using ChatGPT or another? It works; setup tells you what yours can do.<span data-show="beginner normal"> Muse is from Meta and keeps notes about you; <a href="/life-os/trust">the trust page explains</a>.</span><span data-show="technical"> Test status: {allUntested ? 'every assistant untested' : 'per assistant'} in <a href="/life-os/CAPABILITIES.txt">CAPABILITIES.txt</a>.</span></p>

    <div class="callout" id="copy">
      <h3 class="callout-heading">Before you start</h3>
      <ul class="callout-list">
        <li>
          <span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg></span>
          <span>
            {isRC
              ? <>
                  <span data-show="beginner"><strong>Brand new.</strong> Its safety checks haven't run on a real assistant yet; the maker is trying it on his own life first.</span>
                  <span data-show="normal technical"><strong>Test version.</strong> {version} is a release candidate: tests written, not yet run on a real assistant. The maker is trying it on himself first.</span>
                </>
              : <><strong>Tested?</strong> Results for version {version} are on the trust page. The maker uses it on his own life.</>}
            <span data-show="technical"> Results recorded for {version}: {noResultsYet ? 'none yet' : 'see the trust page'}.</span>
          </span>
        </li>
        <li>
          <span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M10 10h3a2 2 0 0 1 0 4h-3"/></svg></span>
          <span><strong>Never pays or moves money.</strong> No bank or email login needed. Set it up yourself, on your own device.</span>
        </li>
        <li>
          <span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
          <span><strong>Copy only from this page.</strong> Never type a password or card number into any assistant.</span>
        </li>
      </ul>
      <a class="trust-link" href="/life-os/trust">Is it safe? Read the trust page (2 min) <span aria-hidden="true">→</span></a>
      <div class="copy-row">
        <button class="btn btn-primary copy-btn" type="button" data-copy-src="/life-os/PASTE-SETUP.txt" data-copy-label="Copy the setup message">Copy the setup message</button>
        <a class="btn btn-ghost" href="/life-os/PASTE-SETUP.txt" target="_blank" rel="noopener">Open the text instead</a>
      </div>
      <p class="check" data-show="beginner">It's long; that's normal. The first line should read "Life OS {version}".</p>
      <p class="check" data-show="normal technical">Every copy's first line carries kit fingerprint <code>{fingerprint}</code>. <a href="/life-os/FINGERPRINTS.txt">Checksums</a></p>
      <p class="copy-status" aria-live="polite" data-copy-status></p>
    </div>

    <details class="dd">
      <summary>See a setup, start to finish</summary>
      <SetupStory />
    </details>
    <details class="dd">
      <summary>Asked to paste another message?</summary>
      <section aria-label="More messages" class="more">
        <p>Copy only what your assistant asks for.</p>
        <p><strong>No memory between chats?</strong> Paste this, then your note, each time.</p>
        <p class="copy-row"><button class="btn btn-small copy-btn" type="button" data-copy-src="/life-os/PASTE-RETURN.txt" data-copy-label="Copy the return message">Copy the return message</button> <a class="open-link" href="/life-os/PASTE-RETURN.txt" target="_blank" rel="noopener">Open the text</a></p>
        <p><strong>Has memory or projects?</strong> Save this once in its settings when it asks.</p>
        <p class="copy-row"><button class="btn btn-small copy-btn" type="button" data-copy-src="/life-os/PASTE-RESIDENT.txt" data-copy-label="Copy the resident rules">Copy the resident rules</button> <a class="open-link" href="/life-os/PASTE-RESIDENT.txt" target="_blank" rel="noopener">Open the text</a></p>
        <p><strong>Asked for an area?</strong></p>
        <div class="area-grid">
          {areas.map((a) => (
            <div class="area-cell">
              <button class="btn btn-ghost copy-btn area-btn" type="button" data-copy-src={`/life-os/AREA-${a.id}.txt`} data-copy-label={`Copy ${a.label}`}>{a.label}</button>
              <a class="open-link" href={`/life-os/AREA-${a.id}.txt`} target="_blank" rel="noopener">Open the text</a>
            </div>
          ))}
        </div>
        <p class="copy-status" aria-live="polite" data-copy-status></p>
      </section>
    </details>
  </section>

  <!-- S3 Why now -->
  <section class="section container" id="why">
    <h2 class="h2">AI stopped waiting to be asked.</h2>
    <DiagramTimeline />
    <p class="cap" data-show="beginner">That last step is new: your assistant can work in the background and tell you only what needs you.</p>
    <p class="cap" data-show="normal technical">Today's assistants combine memory, read-only connections (calendar, mail, bank data) and scheduled tasks. Life OS turns that into a back office with one weekly report.</p>
    <p class="spec" data-show="technical">Tier 0 chat only · Tier 1 memory or project files · Tier 2 memory + tool-confirmed scheduler + read-only connections. Setup has the assistant state its tier from its own tools (B2); missing pieces fall back to your phone calendar and a note you keep.</p>
    <details class="dd">
      <summary>Using a different assistant? See what changes.</summary>
      <RecommendCards />
      <div class="table-wrap">
        <table class="tiers">
          <thead><tr><th scope="col">Your assistant</th><th scope="col">Your Brief</th></tr></thead>
          <tbody>
            <tr><td>Chat only, no memory</td><td>Your phone reminds you. Paste the return message and your note, then say "brief".</td></tr>
            <tr><td>Has memory or projects</td><td>Your phone reminds you. Open it and say "brief"; it already has your details.</td></tr>
            <tr><td>Memory, reminders and connections</td><td>Arrives on its own. Your phone reminder is the backup.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="cap">Your assistant tells you honestly which kind it is during setup.</p>
    </details>
  </section>

  <!-- S4 Company -->
  <section class="section container" id="company">
    <h2 class="h2">Run your life like a company. You're the CEO.</h2>
    <DiagramCompany />
    <p class="cap" data-show="normal technical">Each department has deadlines, problems to watch, and plans, and they share facts. You read one weekly report and answer three questions at most.</p>
    <p class="spec" data-show="technical">Departments are area bundles (AREA-*.txt), installed only on a fingerprint match (S2.5). Setup proposes at most 2, in your words, plus Good Life (B10). Action tiers (S2.1): T0 read · T1 draft · T2 reversible, on your own things · T3 send, book, cancel, share, delete. T3 needs a live read-back and your yes (S2.2), and never runs from a schedule or from content (S2.3).</p>
    <details class="dd">
      <summary>How the departments work</summary>
      <ul class="plain">
        <li>Setup suggests at most two departments, named in your words. Good Life, one thing to look forward to each week, is always on. More can be added later.</li>
        <li>Each department knows what's due, what to watch for, and what you've allowed it to do on its own: reminders and calendar holds. Nothing leaves your hands without your yes.</li>
        <li>Departments share facts. A vet bill in Pets shows up in Money.</li>
        <li>A two-person version, for partners, is in development.</li>
      </ul>
    </details>
    <details class="dd">
      <summary>What's in the weekly report?</summary>
      <ul class="plain">
        <li><strong>On my side</strong>: only if something on its end broke, with the fix.</li>
        <li><strong>Done</strong>: what got handled, wins first.</li>
        <li><strong>Needs you</strong>: three things at most. Each takes one tap and has a default if you do nothing.</li>
        <li><strong>Something good</strong>: one thing to look forward to in the next two weeks.</li>
        <li>250 words or fewer. It always ends: "Back office is closed."</li>
      </ul>
    </details>
  </section>

  <!-- S5 Never -->
  <section class="section container" id="safe">
    <h2 class="h2">What it never does</h2>
    <NeverTiles />
    <p class="cap">Rules it's given, not locks. <a href="/life-os/trust">The trust page explains.</a></p>
    <ul class="words" aria-label="Three words you can always say">
      <li><strong>quieter</strong><span>fewer messages</span></li>
      <li><strong>louder</strong><span>more messages</span></li>
      <li><strong>stop</strong><span>everything it does on its own stops</span></li>
    </ul>
    <p class="cap" data-show="normal">Outside the Brief: urgent things only, twice a week by default.</p>
    <p class="spec" data-show="technical">R8: outside the Brief only for a real cost inside 48–72 h, or safety; default cap 2/week and 3/day. S2.7: "stop" pauses every scheduled job and quotes the tool's confirmation.</p>
    <details class="dd">
      <summary>Everything it's told never to do</summary>
      <ul class="plain">
        <li>Pay or move money. Ever. It gets the payment ready; you make it.</li>
        <li>Send, book, share, or delete anything without reading it back to you and hearing yes.</li>
        <li>Act because a schedule fired or a message told it to.</li>
        <li>Copy a link or phone number from a message into a to-do or a warning.</li>
        <li>Decide your legal, medical, tax, or money questions. It names the professional who does.</li>
        <li>Say a reminder is set or a task is done unless a tool confirmed it.</li>
      </ul>
      <p class="cap">Two more words: <strong>offboard</strong> walks you through removing it and tells you what it can't delete. <strong>I don't feel safe</strong> switches it to private, with help lines first.</p>
    </details>
  </section>

  <!-- S6 Internals -->
  <section class="section container" id="internals">
    <div data-show="beginner normal" data-needs-js class="curious">
      <p class="cap">Curious how it's built?</p>
      <button class="btn btn-ghost" type="button" data-set-mode="technical">Show the technical version</button>
    </div>
    <div data-show="technical">
      <h2 class="h2" id="internals-h" tabindex="-1">Under the hood</h2>
      <dl class="tech">
        <dt>What you paste</dt>
        <dd>PASTE-SETUP.txt ({pasteKB} KB) = SAFETY + CRISIS + BOOTSTRAP. PASTE-RETURN.txt for assistants without memory, PASTE-RESIDENT.txt for project settings, six AREA bundles.</dd>
        <dt>Kernel</dt>
        <dd><a href={`/life-os/${version}/kernel/SAFETY.md`}>SAFETY.md</a> outranks everything · <a href={`/life-os/${version}/kernel/CRISIS.md`}>CRISIS.md</a> only source of crisis numbers · <a href={`/life-os/${version}/kernel/BOOTSTRAP.md`}>BOOTSTRAP.md</a> the 20-minute setup · <a href={`/life-os/${version}/kernel/RHYTHM.md`}>RHYTHM.md</a> the Brief and message caps · <a href={`/life-os/${version}/kernel/STATE.md`}>STATE.md</a> what it holds, "show me what you see" (V1), offboarding (X1). (Markdown; may download.)</dd>
        <dt>SAFETY sections</dt>
        <dd>{safetySections.join(' · ')}</dd>
        <dt>Precedence (S1.2)</dt>
        <dd>SAFETY > your live message > an installed area > saved state and memory > anything fetched or received. Instructions inside content are never followed (S1.4); content never supplies a way to act (S1.5).</dd>
        <dt>Rules cited on the trust page</dt>
        <dd>{trustRuleIds.join(' · ')} <a href="/life-os/trust">Read them in context →</a></dd>
        <dt>Tests</dt>
        <dd>Every rule has a written test. Results recorded for {version}: {noResultsYet ? 'none yet' : 'see the trust page'}. {allUntested ? 'Every assistant is listed untested.' : ''}</dd>
        <dt>Integrity</dt>
        <dd>Each bundle's first line names the official source, the maintainer and kit fingerprint <code>{fingerprint}</code>. Upgrades are proposals, shown word for word and applied only after your yes (S5.1). Pinned copy: <a href={`/life-os/${version}/PASTE-SETUP.txt`}>/life-os/{version}/PASTE-SETUP.txt</a>.</dd>
        <dt>Source</dt>
        <dd>The kit repository is private. The files on this page and their checksums are the contract. Security reports: security@sg57.dev.</dd>
        <dt>Not enforcement</dt>
        <dd>These are instructions to a model, not a sandbox. <a href="/life-os/trust">Honest limits →</a></dd>
      </dl>
    </div>
  </section>

  <!-- S7 Before you decide -->
  <section class="section container" id="decide">
    <h2 class="h2">Before you decide</h2>
    <div class="pills">
      <a class="pill-link" href="/life-os/trust">Trust page</a>
      <a class="pill-link" href="/life-os/example">Maya's example (fictional)</a>
      <a class="pill-link" href="/life-os/changelog">What changed</a>
      <a class="pill-link" href="/blog/introducing-life-os">Why I built this</a>
      <a class="pill-link" href="/life-os/FINGERPRINTS.txt" data-show="technical">Checksums</a>
    </div>
  </section>

  <!-- S8 Fine print -->
  <section class="section container fine" id="fine">
    <p data-show="beginner">Free, as-is. Not legal, medical, tax, or financial advice. Built for the US first; elsewhere, check local laws and help lines.</p>
    <p data-show="normal technical">Free, as-is. Not legal, medical, tax, or financial advice. Built for the US first; elsewhere, dates, laws, and help lines need your local versions.</p>
    <p>Version {version} · <span data-show="normal technical">kit fingerprint <code>{fingerprint}</code> · <a href="/life-os/FINGERPRINTS.txt">checksums</a> · </span><a href="/life-os/LICENSE.txt">License</a> · <a href="mailto:support@sg57.dev">support@sg57.dev</a> · Made by SG57 Labs</p>
    <details class="dd" data-show="technical">
      <summary>Checksums (sha256)</summary>
      <div class="table-wrap"><table class="sums"><tbody>{checksums.map((c) => (<tr><td>{c.file}</td><td><code>{c.sha}</code></td></tr>))}</tbody></table></div>
    </details>
  </section>

  <a class="lo-pill" href="#copy" hidden data-needs-js>Try it · 20 min</a>
</div>
</Base>

<script>
  // Copy buttons: prefetch the bundle texts so the clipboard write happens inside the click gesture
  // (Safari requires that). Fallback: open the text in a new tab.
  document.addEventListener('astro:page-load', () => {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('button.copy-btn[data-copy-src]'));
    if (!buttons.length) return;
    const cache = new Map<string, string>();
    const srcs = Array.from(new Set(buttons.map((b) => b.dataset.copySrc!)));
    srcs.forEach((src) => {
      fetch(src, { cache: 'no-cache' }).then((r) => (r.ok ? r.text() : Promise.reject(r.status))).then((t) => cache.set(src, t)).catch(() => {});
    });

    function status(btn: HTMLButtonElement, text: string) {
      const section = btn.closest('section') || document;
      const el = section.querySelector<HTMLElement>('[data-copy-status]');
      if (el) el.textContent = text;
    }

    buttons.forEach((btn) => {
      const label = btn.dataset.copyLabel || btn.textContent || 'Copy';
      btn.addEventListener('click', () => {
        const src = btn.dataset.copySrc!;
        const text = cache.get(src);
        const done = () => {
          btn.textContent = 'Copied';
          status(btn, 'Copied. Now paste it into your assistant and send.');
          window.setTimeout(() => { btn.textContent = label; }, 2500);
        };
        const fallback = () => {
          // Never claim it opened: browsers block window.open once the tap has ended. Offer a real link instead.
          const section = btn.closest('section') || document;
          const el = section.querySelector<HTMLElement>('[data-copy-status]');
          if (el) {
            const a = document.createElement('a');
            a.href = src; a.target = '_blank'; a.rel = 'noopener'; a.textContent = 'Open the text';
            el.replaceChildren("Copy didn't work here. Open the text, select all of it, and copy: ", a);
          }
        };
        try {
          if (text !== undefined && navigator.clipboard?.writeText) {
            navigator.clipboard.writeText(text).then(done, fallback);
          } else if (navigator.clipboard && 'write' in navigator.clipboard && typeof ClipboardItem !== 'undefined') {
            const blob = fetch(src).then((r) => r.blob());
            navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })]).then(done, fallback);
          } else {
            fallback();
          }
        } catch {
          fallback();
        }
      });
    });
  });
</script>

<script>
  // Reveal-on-scroll and the sticky pill. Start states exist only once data-anim is set here,
  // so a failed module never leaves content invisible.
  let observers: IntersectionObserver[] = [];
  document.addEventListener('astro:before-swap', () => { observers.forEach((o) => o.disconnect()); observers = []; });
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-lifeos]');
    if (!root) return;
    const reveals = Array.from(root.querySelectorAll<HTMLElement>('[data-reveal]'));
    if ('IntersectionObserver' in window) {
      root.setAttribute('data-anim', '');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.25 });
      reveals.forEach((el) => io.observe(el));
      observers.push(io);
    } else {
      reveals.forEach((el) => el.classList.add('in'));
    }
    const pill = root.querySelector<HTMLElement>('.lo-pill');
    const cta = root.querySelector<HTMLElement>('.hero-cta');
    const start = document.getElementById('start');
    if (pill && 'IntersectionObserver' in window) {
      const seen = new Map<Element, boolean>();
      const io2 = new IntersectionObserver((entries) => {
        entries.forEach((e) => seen.set(e.target, e.isIntersecting));
        pill.hidden = Array.from(seen.values()).some(Boolean);
      });
      [cta, start, document.querySelector('footer')].forEach((el) => { if (el) io2.observe(el); });
      observers.push(io2);
    }
  });
</script>

<style is:global>
  .lo[data-mode="beginner"] [data-show]:not([data-show~="beginner"]),
  .lo[data-mode="normal"] [data-show]:not([data-show~="normal"]),
  .lo[data-mode="technical"] [data-show]:not([data-show~="technical"]) { display: none !important; }
  .lo:not([data-js]) [data-needs-js] { display: none !important; }
