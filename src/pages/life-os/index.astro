---
import Base from '../../layouts/Base.astro';
import LoStyles from '../../components/life-os/LoStyles.astro';
import LoRuntime from '../../components/life-os/LoRuntime.astro';
import ModeSwitch from '../../components/life-os/ModeSwitch.astro';
import BriefPhone from '../../components/life-os/BriefPhone.astro';
import ThenNow from '../../components/life-os/ThenNow.astro';
import NotAnApp from '../../components/life-os/NotAnApp.astro';
import DiagramCompany from '../../components/life-os/DiagramCompany.astro';
import Filmstrip from '../../components/life-os/Filmstrip.astro';
import NeverTiles from '../../components/life-os/NeverTiles.astro';
import { version, fingerprint, pasteKB, isRC, allUntested, assertCited, assertRecommended, assertStartSays } from '../../lib/lifeos-kit';

// Every rule id this page cites, with a phrase its definition must still contain. The build fails on drift.
assertCited({
  'S2.1': /T3 irreversible/i, 'S2.2': /read-back/i, 'S2.3': /never runs from a schedule/i, 'S2.4': /pay or move money/i,
  'S2.5': /autonomy_max/i, 'S2.7': /"stop"/i, 'S3.2': /professional/i, 'B2': /what you can do here/i,
  'B10': /at most 2 areas/i, 'R1': /One Brief a week/i,
});
assertRecommended(['Meta Muse', 'Grok Bot']);
assertStartSays([/Meta Muse\*\*: free to start/i, /Grok Bot\*\*[^\n]*\bpaid\b/i]);

const SLIDES = [
  { id: 'top', label: 'Start' },
  { id: 'company', label: 'Your life as a company' },
  { id: 'get', label: 'What you get' },
  { id: 'why', label: 'Why now' },
  { id: 'not-an-app', label: 'Not an app' },
  { id: 'how', label: 'How it works' },
  { id: 'safe', label: 'What it never does' },
  { id: 'start', label: 'Set it up' },
  { id: 'more', label: 'Details' },
];
const howSteps = [
  { d: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2', label: 'Set up', sub: '20 minutes, once' },
  { d: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4', label: 'Approve', sub: 'what it may see and do' },
  { d: 'M4 5h16v11H9l-5 4z', label: 'Relax', sub: 'it messages you first', accent: true },
];
---

<Base
  title="Life OS: Enjoy adulthood. Let your AI do the adulting | SG57 Labs"
  description="Life OS is not an app. It's a job description you paste into the AI you already use, so it runs the boring parts of your life and messages you first. Free. Test version."
  accentColor="#8FBF9F"
  accentHover="#A3D1B1"
  accentMuted="#6F9D80"
  accentGlow="rgba(143, 191, 159, 0.15)"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Set up Life OS in your AI assistant',
    description: 'Copy one setup message, paste it into the AI assistant you already use, answer its questions for about twenty minutes.',
    totalTime: 'PT20M',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Open your AI app', text: 'Open the AI assistant you already use, on your own device.' },
      { '@type': 'HowToStep', position: 2, name: 'Copy the setup message', text: 'Copy the whole setup message from sg57.dev/life-os.' },
      { '@type': 'HowToStep', position: 3, name: 'Paste it and answer', text: 'Paste it, send it, and answer the questions. No bank or email connection is needed.' },
    ],
  }}
>
<LoStyles />
<div class="lo lo-slides" data-lifeos data-mode="beginner">
<script is:inline data-astro-rerun>
(function(){var r=document.querySelector('[data-lifeos]');if(!r)return;r.setAttribute('data-js','');
var M=['beginner','normal','technical'],m=null;
try{var q=new URLSearchParams(location.search).get('mode');if(M.indexOf(q)>-1)m=q;}catch(e){}
if(!m){try{var s=localStorage.getItem('lifeos-mode');if(M.indexOf(s)>-1)m=s;}catch(e){}}
r.setAttribute('data-mode',m||'beginner');})();
</script>
<a class="sr-only lo-skip" href="#copy">Skip to the setup message</a>

  <nav class="dots" aria-label="Sections">
    <ol>
      {SLIDES.map((s, i) => (
        <li><a href={`#${s.id}`} data-dot={s.id} aria-current={i === 0 ? 'true' : undefined}><span class="sr-only">{s.label}</span></a></li>
      ))}
    </ol>
  </nav>

  <!-- 1 · Hero -->
  <section class="slide hero" id="top">
    <div class="slide-inner">
      <div class="hero-text">
        <span class="eyebrow" data-show="beginner normal">LIFE OS · FREE FOR EVERYONE · {isRC ? 'TEST VERSION' : 'VERSION ' + version}</span>
        <span class="eyebrow" data-show="technical">LIFE OS {version}{isRC ? ' · RELEASE CANDIDATE' : ''}</span>
        <h1 class="headline">Enjoy adulthood.<br /><span class="headline-accent">Let your AI do the adulting.</span></h1>
        <p class="line">AI apps can now remember you and reach out on their own.</p>
        <div class="line-stack">
          <p class="line line-strong" data-show="beginner">Life OS isn't an app. It's a message you paste in that gives your AI one job: the boring parts of your life.</p>
          <p class="line line-strong" data-show="normal technical">Life OS isn't an app. It's one message you paste into the AI you already use: twenty minutes of questions, then one short Brief a week, and it messages you first when something needs you.</p>
        </div>
        <p class="line line-quiet">Made by one person, given to everyone. Nothing to buy, now or later.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#copy">Set it up · 20 min</a>
          <a class="btn btn-ghost" href="#company">Show me <span aria-hidden="true">↓</span></a>
        </div>
        <div class="mode-row">
          <ModeSwitch />
          <a class="lo-safe" href="/life-os/trust">Is it safe? <span aria-hidden="true">→</span></a>
        </div>
        <p class="spec" data-show="technical">Vendor-neutral prompt kit · kit {fingerprint} · {pasteKB} KB setup paste · 5 kernel files · 3 capability tiers</p>
      </div>
    </div>
  </section>

  <!-- 2 · Company -->
  <section class="slide slide-alt" id="company">
    <div class="slide-inner slide-inner-wide">
      <div class="slide-copy" data-reveal>
        <h2 class="h2">Your life becomes a company. You're the CEO.</h2>
        <div class="line-stack">
          <p class="line" data-show="beginner">Every chore gets a department. Departments talk to each other. You get one short Brief a week.</p>
          <p class="line" data-show="normal technical">Each department has goals, deadlines, and a plan, and they share facts. You read one Brief and answer three questions at most.</p>
        </div>
        <p class="spec" data-show="technical">Departments are area bundles (AREA-*.txt), installed only on a fingerprint match (S2.5). Setup proposes at most 2, in your words, plus Good Life (B10).</p>
      </div>
      <DiagramCompany compact />
    </div>
  </section>

  <!-- 3 · What you get -->
  <section class="slide" id="get">
    <div class="slide-inner">
      <div class="slide-copy" data-reveal>
        <h2 class="h2">One short Brief a week.</h2>
        <div class="line-stack">
          <p class="line" data-show="beginner">Sunday night. Three things at most, one tap each. Don't reply, and they wait for next week.</p>
          <p class="line" data-show="normal technical">Done, Needs you (three at most, each with a default if you do nothing), Something good. If your app can't message first, a phone reminder does.</p>
        </div>
        <p class="spec" data-show="technical">RHYTHM R1: 250 words or fewer; "On my side" appears only when something broke. Tier 2 sends it on a schedule; tiers 0 and 1 rely on a phone-calendar reminder.</p>
      </div>
      <BriefPhone>
        <span>Example, with made-up details.</span>
      </BriefPhone>
    </div>
  </section>

  <!-- 4 · Why now -->
  <section class="slide slide-alt" id="why">
    <div class="slide-inner">
      <div class="slide-copy" data-reveal>
        <h2 class="h2">AI stopped waiting to be asked.</h2>
        <div class="line-stack">
          <p class="line" data-show="beginner">That last part is new. It's what makes Life OS possible.</p>
          <p class="line" data-show="normal technical">Mainstream assistants now have memory, read-only connections to calendar and mail, and scheduled tasks. Life OS turns those into a back office with one weekly report.</p>
        </div>
        <p class="spec" data-show="technical">Tier 0 chat only · Tier 1 memory or project files · Tier 2 memory + tool-confirmed scheduler + read-only connections. Setup has the assistant state its tier from its own tools (B2).</p>
      </div>
      <ThenNow />
    </div>
  </section>

  <!-- 5 · Not an app -->
  <section class="slide" id="not-an-app">
    <div class="slide-inner">
      <div class="slide-copy" data-reveal>
        <h2 class="h2 h2-loud">Life OS is <span class="headline-accent">not</span> an app.</h2>
        <p class="line">Nothing to download. No account. It's a job description you paste into the AI you already have.</p>
        <p class="line line-strong">"Life OS" is just the name for a set of instructions. Your AI follows them.</p>
        <p class="line line-quiet">Nothing is for sale here. It's plain text you can read, free to use, copy, and change.</p>
        <p class="spec" data-show="technical">Plain text: SAFETY + CRISIS + BOOTSTRAP in one {pasteKB} KB paste, five kernel files, six optional area bundles. No code runs on your device.</p>
      </div>
      <NotAnApp />
    </div>
  </section>

  <!-- 6 · How it works -->
  <section class="slide slide-alt" id="how">
    <div class="slide-inner">
      <div class="slide-copy" data-reveal>
        <h2 class="h2">Like a tax accountant, for all of it.</h2>
        <div class="line-stack">
          <p class="line" data-show="beginner">Set it up once. Approve what it may see. It does the rest and reaches out when it needs you.</p>
          <p class="line" data-show="normal technical">It drafts; you send. It prepares the payment; you pay. Reminders and calendar holds are the only things it does alone.</p>
        </div>
        <p class="spec" data-show="technical">Action tiers (S2.1): T0 read · T1 draft · T2 reversible, on your own things · T3 send, book, cancel, share, delete. T3 needs a live read-back and your yes (S2.2), never from a schedule or from content (S2.3).</p>
      </div>
      <Filmstrip steps={howSteps} label="Set up, approve, relax" />
    </div>
  </section>

  <!-- 7 · Never -->
  <section class="slide" id="safe">
    <div class="slide-inner slide-inner-wide">
      <div class="slide-copy" data-reveal>
        <h2 class="h2">It never pays, sends, or deletes without you.</h2>
        <div class="line-stack">
          <p class="line" data-show="beginner">Say "stop" and it stops. These are instructions it follows, not hard locks{isRC ? ', and they are untested on a real assistant so far' : ''}. <a href="/life-os/trust">Honest limits</a>.</p>
          <p class="line" data-show="normal technical">Say "quieter", "louder", or "stop" at any time. These are instructions it follows, not hard locks{isRC ? ', and no test has run on a real assistant yet' : ''}. <a href="/life-os/trust">The trust page explains</a> what that means.</p>
        </div>
        <p class="spec" data-show="technical">S2.4 never-list · S2.7 "stop" pauses every scheduled job and quotes the tool's confirmation · S3.2 professionals, not advice.</p>
      </div>
      <NeverTiles />
    </div>
  </section>

  <!-- 8 · Try it -->
  <section class="slide" id="start">
    <div class="slide-inner">
      <div class="slide-copy" data-reveal>
        <h2 class="h2">Free, for everyone. One paste.</h2>
        <p class="line best">We recommend <strong>Meta Muse</strong> (free to start) or <strong>Grok Bot</strong> (paid). Any assistant works; setup tells you what yours can do.<span data-show="technical"> Test status: {allUntested ? 'every assistant untested' : 'per assistant'} in <a href="/life-os/CAPABILITIES.txt">CAPABILITIES.txt</a>.</span></p>
        <p class="line">Muse is made by Meta. By default it learns from your chats; you can turn that off in its settings. <a href="/life-os/trust">What else to know</a>.</p>
      </div>
      <div class="callout" id="copy">
        <ul class="facts">
          <li>
            <span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg></span>
            <span>
              {isRC
                ? <>
                    <span data-show="beginner"><strong>Brand new.</strong> Its safety checks haven't run on a real assistant yet; the maker is trying it on his own life first.</span>
                    <span data-show="normal technical"><strong>Test version.</strong> {version} is a release candidate: tests written, not yet run on a real assistant. The maker is trying it on himself first.</span>
                  </>
                : <><strong>Tested?</strong> Results for version {version} are on the trust page. The maker uses it on his own life.</>}
            </span>
          </li>
          <li>
            <span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M10 10h3a2 2 0 0 1 0 4h-3"/></svg></span>
            <span><strong>Never pays or moves money.</strong> No bank or email login needed.</span>
          </li>
          <li>
            <span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
            <span><strong>Copy only from this page.</strong> Never type a password.</span>
          </li>
        </ul>
        <div class="copy-row">
          <button class="btn btn-primary copy-btn" type="button" data-copy-src="/life-os/PASTE-SETUP.txt" data-copy-label="Copy the setup message" data-needs-js>Copy the setup message</button>
          <a class="btn btn-ghost" href="/life-os/PASTE-SETUP.txt" target="_blank" rel="noopener">Open the text instead</a>
        </div>
        <p class="check" data-show="beginner">It's long; that's normal. The first line reads "Life OS {version}".</p>
        <p class="check" data-show="normal technical">Every copy's first line carries kit fingerprint <code>{fingerprint}</code>. <a href="/life-os/FINGERPRINTS.txt">Checksums</a></p>
        <p class="copy-status" aria-live="polite" data-copy-status></p>
      </div>
      <p class="after">
        <a href="/life-os/details#more">Asked to paste another message? <span aria-hidden="true">→</span></a>
        <a href="/life-os/trust">Is it safe? <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- 9 · More -->
  <section class="slide slide-alt slide-last" id="more">
    <div class="slide-inner">
      <div class="slide-copy" data-reveal>
        <h2 class="h2">Want the details?</h2>
        <p class="line">Everything this page leaves out, in one place.</p>
      </div>
      <div class="cards">
        <a class="card" href="/life-os/details"><strong>How it works, in depth</strong><span>Assistants, setup, departments, every rule.</span></a>
        <a class="card" href="/life-os/trust"><strong>Is it safe?</strong><span>Honest limits, in two minutes.</span></a>
        <a class="card" href="/life-os/example"><strong>A full example</strong><span>Maya's setup, fictional, start to finish.</span></a>
        <a class="card" href="/blog/introducing-life-os"><strong>Why I built this</strong><span>From the maker.</span></a>
      </div>
      <div class="fine-block">
        <p class="fine">Free for everyone, as-is, under <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a>: use it, copy it, change it. Not legal, medical, tax, or financial advice. Built for the US first.</p>
        <p class="fine">Version {version} · <span data-show="normal technical">kit fingerprint <code>{fingerprint}</code> · <a href="/life-os/FINGERPRINTS.txt">checksums</a> · </span><a href="/life-os/LICENSE.txt">License</a> · <a href="mailto:support@sg57.dev">support@sg57.dev</a> · Made by SG57 Labs</p>
      </div>
    </div>
  </section>

  <a class="lo-pill" href="#copy" hidden data-needs-js>Set it up · free</a>
</div>
<LoRuntime />
</Base>

<style is:global>
  /* One screen per idea. Phones: proximity snap, because tall slides there must keep scrolling freely.
     Desktop (every slide fits): mandatory snap, one slide per wheel tick, and the footer is its own stop so
     Terms and Privacy stay reachable. */
  html:has(.lo-slides) { scroll-padding-top: 3.5rem; }
  @media (min-height: 640px) {
    html:has(.lo-slides) { scroll-snap-type: y proximity; }
    .lo-slides .slide { scroll-snap-align: start; }
    html:has(.lo-slides) footer { scroll-snap-align: end; }
  }
  @media (min-width: 900px) and (min-height: 640px) {
    html:has(.lo-slides) { scroll-snap-type: y mandatory; }
    .lo-slides .slide { scroll-snap-stop: always; }
  }
  @media (max-width: 899px) { html:has(.lo-slides) { scroll-padding-bottom: calc(5rem + env(safe-area-inset-bottom)); } }
</style>

<style>
  .lo-skip { position: absolute; left: 1rem; top: -100%; z-index: 200; background: var(--sg57-accent); color: var(--sg57-text-on-accent); padding: 0.6rem 1rem; border-radius: var(--sg57-radius-md); }
  .lo-skip:focus { top: 4rem; width: auto; height: auto; clip: auto; clip-path: none; overflow: visible; }

  .slide { position: relative; min-height: calc(100vh - 3.5rem); display: flex; align-items: center; padding: 2.5rem 1.25rem; }
  @supports (height: 100svh) { .slide { min-height: calc(100svh - 3.5rem); } }
  .slide-last { min-height: 0; padding-bottom: 4rem; }
  .slide-alt::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(70% 60% at 50% 50%, var(--sg57-accent-glow), transparent 70%); opacity: 0.6; }
  .slide-inner { position: relative; width: 100%; max-width: 820px; margin: 0 auto; display: grid; gap: 2.25rem; justify-items: center; text-align: center; }
  .slide-inner-wide { max-width: 1000px; }
  #start .slide-inner { gap: 1.5rem; }
  .slide-copy { max-width: 680px; }
  .slide-copy .line { max-width: 52ch; margin-left: auto; margin-right: auto; }
  .h2 { font-family: var(--sg57-font-display); font-weight: 700; font-size: clamp(2rem, 5.5vw, 3.4rem); line-height: 1.05; color: var(--sg57-text-bright); margin: 0 0 1rem; letter-spacing: -0.01em; }
  .h2-loud { font-size: clamp(2.4rem, 7vw, 4.4rem); }
  .line-stack { display: grid; }
  .line-stack > .line { grid-area: 1 / 1; }
  .line { font-size: clamp(1.05rem, 2.2vw, 1.3rem); line-height: 1.5; color: var(--sg57-text); margin: 0; }
  .line + .line { margin-top: 0.75rem; }
  .line-quiet { color: var(--sg57-text-dim); font-size: clamp(0.98rem, 1.9vw, 1.1rem); }
  .line-strong { color: var(--sg57-text-bright); font-weight: 600; }
  .best strong { color: var(--sg57-text-bright); }

  .hero-text { display: grid; justify-items: center; max-width: 720px; }
  .eyebrow { display: inline-block; font-family: var(--sg57-font-display); font-weight: 600; letter-spacing: 0.18em; font-size: 0.85rem; color: var(--sg57-accent); margin-bottom: 0.9rem; }
  .headline { font-family: var(--sg57-font-display); font-weight: 700; font-size: clamp(2.3rem, 6.5vw, 4rem); line-height: 1.05; color: var(--sg57-text-bright); margin: 0 0 1.1rem; letter-spacing: -0.01em; }
  .headline-accent { color: var(--sg57-accent); }
  .hero-text .line { max-width: 52ch; }
  .hero-text .line-stack { margin-top: 0.75rem; }
  .hero-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin: 1.6rem 0 1rem; }
  .mode-row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.75rem 1.25rem; }
  .lo-safe { display: inline-flex; align-items: center; min-height: 44px; color: var(--sg57-accent); font-family: var(--sg57-font-display); font-weight: 600; letter-spacing: 0.04em; text-decoration: none; }
  .lo-safe:hover { text-decoration: underline; }

  .callout { width: 100%; max-width: 640px; text-align: left; background: var(--sg57-glass-bg); backdrop-filter: blur(var(--sg57-glass-blur)); border: 1px solid var(--sg57-glass-border); border-left: 3px solid var(--sg57-accent); border-radius: var(--sg57-radius-lg); box-shadow: var(--sg57-glass-shadow); padding: 1rem 1.2rem 1.1rem; }
  .facts { list-style: none; margin: 0 0 0.9rem; padding: 0; display: grid; gap: 0.55rem; }
  .facts li { display: grid; grid-template-columns: 20px 1fr; gap: 0.6rem; align-items: start; line-height: 1.5; color: var(--sg57-text); font-size: 0.98rem; }
  .facts strong { color: var(--sg57-text-bright); }
  .ci { width: 20px; height: 20px; color: var(--sg57-accent); margin-top: 0.15rem; }
  .ci svg { width: 20px; height: 20px; }
  .after { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.5rem; margin: 0; }
  .after a { display: inline-flex; align-items: center; min-height: 44px; color: var(--sg57-accent); font-family: var(--sg57-font-display); font-weight: 600; letter-spacing: 0.03em; text-decoration: none; }
  .after a:hover { text-decoration: underline; }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.9rem; width: 100%; }
  .card { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.1rem 1.2rem; border-radius: var(--sg57-radius-lg); background: var(--sg57-glass-bg); border: 1px solid var(--sg57-glass-border); text-decoration: none; color: inherit; text-align: left; }
  .card:hover { border-color: var(--sg57-accent); }
  .card:focus-visible { outline: 2px solid transparent; box-shadow: var(--sg57-focus-ring); }
  .card strong { font-family: var(--sg57-font-display); font-weight: 700; font-size: 1.15rem; color: var(--sg57-text-bright); }
  .card span { color: var(--sg57-text-dim); font-size: 0.95rem; line-height: 1.45; }
  .fine-block { margin-top: 0.5rem; }
  .fine-block .fine { margin-left: auto; margin-right: auto; }

  .dots { display: none; }
  .lo-pill { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(1rem + env(safe-area-inset-bottom)); z-index: 90; display: inline-flex; align-items: center; min-height: 44px; padding: 0.6rem 1.2rem; border-radius: var(--sg57-radius-full); background: var(--sg57-accent); color: var(--sg57-text-on-accent); font-family: var(--sg57-font-display); font-weight: 700; letter-spacing: 0.04em; text-decoration: none; box-shadow: var(--sg57-glass-shadow); }
  .lo-pill[hidden] { display: none !important; }

  @media (max-width: 899px) {
    .slide { padding-bottom: 5rem; }
  }
  @media (min-width: 900px) {
    .lo-pill { left: auto; right: calc(1.5rem + 44px + 0.75rem); transform: none; }
    .dots { display: block; position: fixed; right: 0.6rem; top: 50%; transform: translateY(-50%); z-index: 80; }
    .dots ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
    .dots a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; }
    .dots a::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--sg57-text-dim); opacity: 0.6; }
