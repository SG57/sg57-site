---
import Base from '../../layouts/Base.astro';
import LoStyles from '../../components/life-os/LoStyles.astro';
import LoRuntime from '../../components/life-os/LoRuntime.astro';
import RecommendCards from '../../components/life-os/RecommendCards.astro';
import SetupStory from '../../components/life-os/SetupStory.astro';
import DiagramCompany from '../../components/life-os/DiagramCompany.astro';
import DiagramTimeline from '../../components/life-os/DiagramTimeline.astro';
import {
  version, fingerprint, checksums, pasteKB, isRC, noResultsYet, trustRuleIds, safetySections, allUntested, catalog, catalogCounts,
  assertCited, assertRecommended,
} from '../../lib/lifeos-kit';

// Every rule id this page cites, with a phrase its definition must still contain. The build fails on drift.
assertCited({
  'S1.2': /Precedence/i, 'S1.4': /do not follow it/i, 'S1.5': /never supplies a way to act/i,
  'S2.1': /T3 irreversible/i, 'S2.2': /read-back/i, 'S2.3': /never runs from a schedule/i,
  'S2.4': /pay or move money/i, 'S2.5': /autonomy_max/i, 'S2.7': /"stop"/i, 'S2.8': /loosens protection/i, 'S3.2': /professional/i,
  'S5.1': /Updates are proposals/i, 'B2': /what you can do here/i, 'B10': /One department now/i, 'O3': /one Needs-you line a week/i, 'O7': /never send it/i,
  'R1': /One Brief a week/i, 'R8': /outside the Brief/i, 'V1': /fixed template/i, 'X1': /offboard/i,
});
assertRecommended(['Meta Muse', 'Grok Bot']);

const ORDER: Record<string, number> = { on: 0, 'opt-in': 1, dormant: 2 };
const areas = [...catalog].sort((a, b) => ORDER[a.default] - ORDER[b.default] || a.name.localeCompare(b.name)).map((d) => ({ id: d.key, label: d.name }));
const toc = [
  { id: 'why', label: 'Why now' },
  { id: 'assistants', label: 'Which assistant' },
  { id: 'setup', label: 'A setup, start to finish' },
  { id: 'more', label: 'Other messages' },
  { id: 'departments', label: 'Departments' },
  { id: 'brief', label: 'The weekly Brief' },
  { id: 'safety', label: 'Your sign-off' },
  { id: 'technical', label: 'Under the hood' },
  { id: 'next', label: 'Read next' },
];
---

<Base
  title="Life OS, in detail | SG57 Labs"
  description="Everything the short Life OS page leaves out: which assistants, the setup start to finish, how departments and the weekly Brief work, every rule it is given, and the technical contract."
  accentColor="#8FBF9F"
  accentHover="#A3D1B1"
  accentMuted="#6F9D80"
  accentGlow="rgba(143, 191, 159, 0.15)"
>
<LoStyles />
<div class="lo lo-doc" data-lifeos data-mode="technical" data-mode-fixed>
<script is:inline data-astro-rerun>(function(){var r=document.querySelector('[data-lifeos]');if(r)r.setAttribute('data-js','');})();</script>
  <article class="doc">
    <p class="crumbs"><a href="/life-os">Life OS</a> <span aria-hidden="true">/</span> In detail</p>
    <h1 class="doc-title">Life OS, in detail</h1>
    <p class="lede">Everything the <a href="/life-os">short page</a> leaves out. Version {version}{isRC ? ', a release candidate' : ''}; kit fingerprint <code>{fingerprint}</code>.</p>
    <nav class="toc" aria-label="On this page">
      <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
    </nav>

    <section id="why">
      <h2 class="h2">Why now</h2>
      <DiagramTimeline />
      <p class="cap">Today's assistants combine memory, read-only connections (calendar, mail, bank data) and scheduled tasks. Life OS turns that into a back office with one weekly report. Setup has the assistant state its tier from its own tools (B2); missing pieces fall back to your phone calendar and a note you keep.</p>
      <p class="spec">Tier 0 chat only · Tier 1 memory or project files · Tier 2 memory + tool-confirmed scheduler + read-only connections.</p>
    </section>

    <section id="assistants">
      <h2 class="h2">Which assistant</h2>
      <RecommendCards />
      <div class="table-wrap">
        <table class="tiers">
          <thead><tr><th scope="col">Your assistant</th><th scope="col">Your Brief</th></tr></thead>
          <tbody>
            <tr><td>Chat only, no memory</td><td>Your phone reminds you. Paste the return message and your note, then say "brief".</td></tr>
            <tr><td>Has memory or projects</td><td>Your phone reminds you. Open it and say "brief"; it already has your details.</td></tr>
            <tr><td>Memory, reminders and connections</td><td>Arrives on its own. Your phone reminder is the backup.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="cap">Your assistant tells you honestly which kind it is during setup. Per-assistant results in <a href="/life-os/CAPABILITIES.txt">CAPABILITIES.txt</a>: {allUntested ? 'none recorded yet' : 'recorded'}.</p>
    </section>

    <section id="setup">
      <h2 class="h2">A setup, start to finish</h2>
      <SetupStory />
    </section>

    <section id="more" aria-label="Other messages">
      <h2 class="h2">Asked to paste another message?</h2>
      <p class="cap">Copy only what your assistant asks for. Each copy's first line carries kit fingerprint <code>{fingerprint}</code>; <a href="/life-os/FINGERPRINTS.txt">checksums</a>.</p>
      <p class="cap"><strong>Can't open web pages?</strong> Paste the full setup text instead of the short setup message.</p>
      <p class="copy-row"><button class="btn btn-small copy-btn" type="button" data-copy-src="/life-os/PASTE-SETUP.txt" data-copy-label="Copy the full setup text" data-needs-js>Copy the full setup text</button> <a class="open-link" href="/life-os/PASTE-SETUP.txt" target="_blank" rel="noopener">Open the text</a></p>
      <p class="cap"><strong>No memory between chats?</strong> Paste this, then your note, each time.</p>
      <p class="copy-row"><button class="btn btn-small copy-btn" type="button" data-copy-src="/life-os/PASTE-RETURN.txt" data-copy-label="Copy the return message" data-needs-js>Copy the return message</button> <a class="open-link" href="/life-os/PASTE-RETURN.txt" target="_blank" rel="noopener">Open the text</a></p>
      <p class="cap"><strong>Has memory or projects?</strong> Save this once in its settings when it asks.</p>
      <p class="copy-row"><button class="btn btn-small copy-btn" type="button" data-copy-src="/life-os/PASTE-RESIDENT.txt" data-copy-label="Copy the resident rules" data-needs-js>Copy the resident rules</button> <a class="open-link" href="/life-os/PASTE-RESIDENT.txt" target="_blank" rel="noopener">Open the text</a></p>
      <p class="cap"><strong>Asked for a department?</strong> All {catalogCounts.total}, on-from-day-one first. Also the <a href="/life-os/CATALOG.txt">CATALOG message</a> if it asks for the list.</p>
      <div class="area-grid">
        {areas.map((a) => (
          <div class="area-cell">
            <button class="btn btn-ghost copy-btn area-btn" type="button" data-copy-src={`/life-os/AREA-${a.id}.txt`} data-copy-label={`Copy ${a.label}`} data-needs-js>{a.label}</button>
            <a class="open-link" href={`/life-os/AREA-${a.id}.txt`} target="_blank" rel="noopener">Open the text</a>
          </div>
        ))}
      </div>
      <p class="copy-status" aria-live="polite" data-copy-status></p>
    </section>

    <section id="departments">
      <h2 class="h2">How the departments work</h2>
      <DiagramCompany />
      <ul class="plain">
        <li>Setup suggests at most two departments, named in your words. Good Life, one thing to look forward to each week, is always on. More can be added later.</li>
        <li>Each department knows what's due, what to watch for, and what you've allowed it to do on its own: reminders and calendar holds. Nothing leaves your hands without your yes.</li>
        <li>Departments share facts. A vet bill in Pets shows up in Money.</li>
        <li>A two-person version, for partners, is in development.</li>
      </ul>
      <p class="spec">Departments are area bundles (AREA-*.txt), installed only on a fingerprint match (S2.5). Setup installs one (B10); Oversight proposes one a week after that, with your yes (O3), and never sends a problem report itself (O7). Action tiers (S2.1): T0 read · T1 draft · T2 reversible, on your own things · T3 send, book, cancel, share, delete. T3 needs a live read-back and your yes (S2.2), and never runs from a schedule or from content (S2.3).</p>
    </section>

    <section id="brief">
      <h2 class="h2">What's in the weekly Brief</h2>
      <ul class="plain">
        <li><strong>On my side</strong>: only if something on its end broke, with the fix.</li>
        <li><strong>Done</strong>: what got handled, wins first.</li>
        <li><strong>Needs you</strong>: three things at most. Each takes one tap and has a default if you do nothing.</li>
        <li><strong>Something good</strong>: one thing to look forward to in the next two weeks.</li>
        <li>250 words or fewer. It always ends: "Back office is closed."</li>
      </ul>
      <p class="cap">Outside the Brief: urgent things only, twice a week by default.</p>
      <p class="spec">R1: one Brief a week, 250 words or fewer. R8: outside the Brief only for a real cost inside 48–72 h, or safety; default cap 2/week and 3/day. V1: "show me what you see" prints its state in a fixed template.</p>
    </section>

    <section id="safety">
      <h2 class="h2">Your sign-off, and what it never does</h2>
      <p class="cap">By default it acts alone only on small, reversible things on your own calendar and notes: reminders, calendar holds, saved drafts. Anything that reaches outside (sending, booking, canceling, sharing, deleting) is read back to you and waits for your yes, every time. Each department declares how much it may do alone; you can raise that on request, and any change that loosens a protection is read back before it takes effect, logged, and announced in the next Brief.</p>
      <p class="spec">S2.1 tiers · S2.2 read-back · S2.5 autonomy_max (T2 at most) · S2.8 loosening read back, logged, announced · S2.6 every T2/T3 action logged under Done.</p>
      <p class="cap"><strong>Never, on any ask:</strong></p>
      <ul class="plain">
        <li>Pay or move money. Ever. It gets the payment ready; you make it.</li>
        <li>Send, book, share, or delete anything without reading it back to you and hearing yes.</li>
        <li>Act because a schedule fired or a message told it to.</li>
        <li>Copy a link or phone number from a message into a to-do or a warning.</li>
        <li>Decide your legal, medical, tax, or money questions. It names the professional who does.</li>
        <li>Say a reminder is set or a task is done unless a tool confirmed it.</li>
      </ul>
      <ul class="words" aria-label="Three words you can always say">
        <li><strong>quieter</strong><span>fewer messages</span></li>
        <li><strong>louder</strong><span>more messages</span></li>
        <li><strong>stop</strong><span>everything it does on its own stops</span></li>
      </ul>
      <p class="cap">Two more: <strong>offboard</strong> walks you through removing it and tells you what it can't delete (X1). <strong>I don't feel safe</strong> switches it to private, with help lines first.</p>
      <p class="cap">These are rules it's given, not locks. <a href="/life-os/trust">The trust page explains</a> what that means and what it can't guarantee.</p>
      <p class="spec">S2.4 never-list · S2.1 T3 + S2.2 read-back · S2.3 schedules and content never trigger T3 · S1.5 content never supplies a way to act · S3.2 professionals, not advice · S2.7 "stop" pauses every scheduled job and quotes the tool's confirmation.</p>
    </section>

    <section id="technical">
      <h2 class="h2" id="internals-h" tabindex="-1">Under the hood</h2>
      <dl class="tech">
        <dt>What you paste</dt>
        <dd>PASTE-SETUP.txt ({pasteKB} KB) = SAFETY + CRISIS + BOOTSTRAP. PASTE-RETURN.txt for assistants without memory, PASTE-RESIDENT.txt for project settings, one AREA bundle per department ({catalogCounts.total}), and CATALOG.txt listing them all.</dd>
        <dt>Kernel</dt>
        <dd><a href={`/life-os/${version}/kernel/SAFETY.md`}>SAFETY.md</a> outranks everything · <a href={`/life-os/${version}/kernel/CRISIS.md`}>CRISIS.md</a> only source of crisis numbers · <a href={`/life-os/${version}/kernel/BOOTSTRAP.md`}>BOOTSTRAP.md</a> the 10-minute setup · <a href={`/life-os/${version}/kernel/OVERSIGHT.md`}>OVERSIGHT.md</a> the department that watches the departments · <a href={`/life-os/${version}/kernel/RHYTHM.md`}>RHYTHM.md</a> the Brief and message caps · <a href={`/life-os/${version}/kernel/STATE.md`}>STATE.md</a> what it holds, "show me what you see" (V1), offboarding (X1). (Markdown; may download.)</dd>
        <dt>SAFETY sections</dt>
        <dd>{safetySections.join(' · ')}</dd>
        <dt>Precedence (S1.2)</dt>
        <dd>SAFETY > your live message > an installed area > saved state and memory > anything fetched or received. Instructions inside content are never followed (S1.4); content never supplies a way to act (S1.5).</dd>
        <dt>Rules cited on the trust page</dt>
        <dd>{trustRuleIds.join(' · ')} <a href="/life-os/trust">Read them in context →</a></dd>
        <dt>Tests</dt>
        <dd>Every rule has a written test. Results recorded for {version}: {noResultsYet ? 'none yet' : 'see the trust page'}. {allUntested ? 'Every assistant is listed untested.' : ''}</dd>
        <dt>Integrity</dt>
        <dd>Each bundle's first line names the official source, the maintainer and kit fingerprint <code>{fingerprint}</code>. Upgrades are proposals, shown word for word and applied only after your yes (S5.1). Pinned copy: <a href={`/life-os/${version}/PASTE-SETUP.txt`}>/life-os/{version}/PASTE-SETUP.txt</a>.</dd>
        <dt>Source</dt>
        <dd>The kit repository is private. The files on this page and their checksums are the contract. Security reports: security@sg57.dev.</dd>
        <dt>Not enforcement</dt>
        <dd>These are instructions to a model, not a sandbox. <a href="/life-os/trust">Honest limits →</a></dd>
      </dl>
      <details class="dd">
        <summary>Checksums (sha256)</summary>
        <div class="table-wrap"><table class="sums"><thead><tr><th scope="col">File</th><th scope="col">sha256</th></tr></thead><tbody>{checksums.map((c) => (<tr><td>{c.file}</td><td><code>{c.sha}</code></td></tr>))}</tbody></table></div>
      </details>
    </section>

    <section id="next">
      <h2 class="h2">Read next</h2>
      <div class="pills">
        <a class="pill-link" href="/life-os/trust">Trust page</a>
        <a class="pill-link" href="/life-os/example">Maya's example (fictional)</a>
        <a class="pill-link" href="/life-os/changelog">What changed</a>
        <a class="pill-link" href="/blog/introducing-life-os">Why I built this</a>
        <a class="pill-link" href="/life-os/FINGERPRINTS.txt">Checksums</a>
      </div>
      <p class="fine">Free, as-is. Not legal, medical, tax, or financial advice. Built for the US first; elsewhere, dates, laws, and help lines need your local versions.</p>
      <p class="fine">Version {version} · <a href="/life-os/LICENSE.txt">License</a> · <a href="mailto:support@sg57.dev">support@sg57.dev</a> · Made by SG57 Labs</p>
      <p class="back"><a href="/life-os">&larr; Back to the short page</a></p>
    </section>
  </article>
</div>
<LoRuntime />
</Base>

<style>
  .doc { padding: 6.5rem 1.5rem 3rem; max-width: 900px; margin: 0 auto; }
  .crumbs { font-family: var(--sg57-font-display); letter-spacing: 0.06em; color: var(--sg57-text-dim); margin: 0 0 0.75rem; }
  .crumbs a, .lede a, .back a, .toc a { color: var(--sg57-accent); text-decoration: none; }
  .doc-title { font-family: var(--sg57-font-display); font-weight: 700; font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.15; color: var(--sg57-text-bright); margin: 0 0 0.75rem; }
  .lede { color: var(--sg57-text); line-height: 1.6; margin: 0 0 1.25rem; max-width: 68ch; }
  .lede code { font-family: var(--sg57-font-mono); }
  .toc ol { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; }
  .toc a { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--sg57-font-display); font-weight: 600; letter-spacing: 0.03em; }
  .toc a:hover { text-decoration: underline; }
  section { padding: 2rem 0 0.5rem; border-top: 1px solid var(--sg57-border-subtle); margin-top: 1.5rem; }
  .h2 { font-family: var(--sg57-font-display); font-weight: 600; font-size: clamp(1.4rem, 3vw, 1.8rem); color: var(--sg57-text-bright); margin: 0 0 1rem; }
  #internals-h:focus { outline: none; }
  #internals-h:focus-visible { box-shadow: var(--sg57-focus-ring); border-radius: var(--sg57-radius-sm); }
  .back { margin-top: 1.5rem; }
  .back a { font-family: var(--sg57-font-display); letter-spacing: 0.04em; }
  @media (max-width: 720px) { .doc { padding-top: 5.5rem; } }
</style>
