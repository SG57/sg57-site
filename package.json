{
  "name": "sg57-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "node scripts/gates/check-ratchet.mjs",
    "check:raw": "astro check",
    "gate:html": "node scripts/gates/html.mjs",
    "gate:css": "node scripts/gates/css.mjs",
    "gate:scripts": "node scripts/gates/page-load.mjs",
    "gate:floors": "node scripts/gates/floors.mjs",
    "gates": "npm run build && node scripts/gates/run-all.mjs",
    "qa": "npm run build && npm run qa:run",
    "qa:run": "node scripts/qa/spine.mjs",
    "gates:all": "npm run gates && npm run qa:run",
    "test:gates": "node --test scripts/gates/selftest.mjs scripts/gates/focus-outline.test.mjs scripts/qa/spine.test.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "html-validate": "11.21.1",
    "postcss-html": "2.0.1",
    "stylelint": "18.1.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "tsconfck": {
      "typescript": "$typescript"
    }
  }
}
